# Reflex (TypeSafe Jev). Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Brain (Claude Opus 5.5) for escalations and the nightly review
ANTHROPIC_API_KEY=
# Operating mode: paper | replay | live  (live requires an exchange adapter and operator sign-off, see docs/05-ship.md)
JEV_TRADER_MODE=paper
JEV_TRADER_EQUITY_USD=10000
JEV_TRADER_JOURNAL=data/journal.jsonl
JEV_TRADER_KILL_SWITCH=data/KILL
# Alertas de setups long/short (opcionais). Telegram: token do @BotFather e chat_id de getUpdates. Webhook: Discord/Slack incoming webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JEV_WEBHOOK_URL=
